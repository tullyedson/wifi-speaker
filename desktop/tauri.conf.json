{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Speaker",
  "version": "0.1.2",
  "identifier": "com.smartspeaker.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Smart Speaker", "width": 1100, "height": 820, "minWidth": 720, "minHeight": 540, "visible": false, "center": true, "backgroundColor": "#111a23" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "category": "Utility", "shortDescription": "Local voice processing for your network speakers", "icon": ["icons/icon.ico"], "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }, "nsis": { "installMode": "currentUser", "languages": ["English"], "startMenuFolder": "Smart Speaker" } } }
}
